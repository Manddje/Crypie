# Only what the image needs goes to the builder (see Dockerfile): requirements.txt and app/.
# Never send secrets, local databases or git history.
.git
.github
.gitignore
.env
.env.*
!.env.example
data/
*.sqlite3
*.sqlite3-*
*.db
**/__pycache__
**/*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
tests/
.claude/
.idea/
.vscode/
*.swp
docker-compose*.yaml
Dockerfile
.dockerignore
README.md
