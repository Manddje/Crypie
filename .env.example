# Copy to .env and fill in. Never commit .env.

# paper = simulate orders locally (default, safe). live = send real orders to Bitvavo.
TRADING_MODE=paper

# Bitvavo API key with at least "view" rights; add "trade" only when going live.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Markets the app watches (Bitvavo notation).
MARKETS=BTC-EUR,ETH-EUR

# Database. The docker-compose file sets this to the bundled Postgres.
# For local tinkering without Docker, sqlite works too: sqlite:///./data/crypie.sqlite3
DATABASE_URL=postgresql+psycopg://crypie:crypie@db:5432/crypie
POSTGRES_PASSWORD=crypie

# Virtual EUR balance used in paper mode.
PAPER_START_EUR=1000

# Needed from step 3 onwards (news analysis).
ANTHROPIC_API_KEY=
