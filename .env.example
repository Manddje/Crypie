# Copy to .env and fill in. Never commit .env.

# paper = simulate orders locally (default, safe). live = send real orders to Bitvavo.
TRADING_MODE=paper

# Bitvavo API key with at least "view" rights; add "trade" only when going live.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Markets the app watches (Bitvavo notation).
MARKETS=BTC-EUR,ETH-EUR

# Database. The docker-compose file sets this to the bundled Postgres.
# For local tinkering without Docker, sqlite works too: sqlite:///./data/crypie.sqlite3
DATABASE_URL=postgresql+psycopg://crypie:crypie@db:5432/crypie
POSTGRES_PASSWORD=crypie

# Virtual EUR balance used in paper mode.
PAPER_START_EUR=1000

# Used by the strategy assistant (step 2) and news analysis (step 3).
ANTHROPIC_API_KEY=
# Hard monthly cap on Claude spend. At 90% the dashboard warns, at 100% Claude calls stop.
CLAUDE_MONTHLY_BUDGET_USD=100
# Model per task (price/quality trade-off is yours to tune).
CLAUDE_MODEL_STRATEGY=claude-opus-5-5
CLAUDE_MODEL_DECISION=claude-sonnet-5-5
CLAUDE_MODEL_NEWS=claude-haiku-5-5
# Weekly self-evaluation (step 4): rare and deep, so the most capable model is affordable here.
CLAUDE_MODEL_EVALUATION=claude-fable-5-1

# Bitvavo taker fee used in backtests (percent).
BACKTEST_FEE_PCT=0.25
