# Copy to .env and fill in. Never commit .env.

# paper = simulate orders locally (default, safe). live = send real orders to Bitvavo.
TRADING_MODE=paper

# Bitvavo API key with at least "view" rights; add "trade" only when going live.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Markets the app watches (Bitvavo notation).
MARKETS=BTC-EUR,ETH-EUR

# Database. Locally docker-compose.override.yaml starts a Postgres container that matches
# this URL; on Coolify point it at the managed Postgres resource (postgresql+psycopg://...).
# For local tinkering without Docker, sqlite works too: sqlite:///./data/crypie.sqlite3
DATABASE_URL=postgresql+psycopg://crypie:crypie@db:5432/crypie
# Password of the local Postgres container only.
POSTGRES_PASSWORD=crypie

# Virtual EUR balance used in paper mode.
PAPER_START_EUR=1000

# Used by the strategy assistant (step 2) and news analysis (step 3).
ANTHROPIC_API_KEY=
# Hard monthly cap on Claude spend. At 90% the dashboard warns, at 100% Claude calls stop.
CLAUDE_MONTHLY_BUDGET_USD=100
# Model per task (price/quality trade-off is yours to tune).
CLAUDE_MODEL_STRATEGY=claude-opus-5-5
CLAUDE_MODEL_DECISION=claude-sonnet-5-5
CLAUDE_MODEL_NEWS=claude-haiku-5-5
# Weekly self-evaluation (step 4): rare and deep, so the most capable model is affordable here.
CLAUDE_MODEL_EVALUATION=claude-fable-5-1

# Bitvavo taker fee used in backtests (percent).
BACKTEST_FEE_PCT=0.25

# News (step 3). RSS and GDELT are free; CryptoPanic needs a paid Growth plan token.
NEWS_ENABLED=true
NEWS_FETCH_INTERVAL_MIN=15
# NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
GDELT_ENABLED=true
CRYPTOPANIC_TOKEN=
CRYPTOPANIC_PLAN=growth

# Trading (step 4). Hard limits; Claude can never exceed them.
TRADING_ENABLED=true
TRADE_INTERVAL_MIN=60
MAX_TRADE_EUR=100
MAX_EXPOSURE_PCT=50
DAILY_LOSS_LIMIT_PCT=5
MAX_TRADES_PER_DAY=6
COOLDOWN_MIN_AFTER_STOP=240
# What to do when Claude is unavailable (budget exhausted, no key, error): hold | indicators
CLAUDE_UNAVAILABLE_MODE=hold
# Weekly self-evaluation by Claude (hours between runs).
EVALUATION_INTERVAL_HOURS=168
# Live mode needs TRADING_MODE=live, trade-enabled Bitvavo keys AND this explicit acknowledgement.
LIVE_TRADING_ACK=false
